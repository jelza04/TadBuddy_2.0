# Copy to .env and fill in. Never commit .env.

# Supabase -> Connect -> Session pooler (port 5432, IPv4-compatible).
# Use session mode, not the transaction pooler (6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

# dev      -> frontend sends X-User-Id (local only)
# supabase -> frontend sends a Supabase Auth access token
AUTH_MODE=dev
SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWT_SECRET=     # only for legacy HS256 projects

CHAT_MODEL=llama3.2:3b
LLM_MAX_CONCURRENCY=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limits (0 disables one)
RATE_LIMIT_PER_MIN=12        # chat messages per user per minute
RATE_LIMIT_PER_DAY=300       # chat messages per user per day
IP_RATE_LIMIT_PER_MIN=60     # all /v1 requests per IP per minute
TRUST_PROXY=false            # true only behind your own reverse proxy (uses X-Forwarded-For)
MAX_MEMORIES_PER_USER=300

EMERGENCY_RESOURCES=Please call your local emergency number right now (112 in India, 911 in the US).
# Replace with verified helpline info for your users' country before real use.
CRISIS_RESOURCES=If you are in immediate danger, please contact your local emergency number or a crisis helpline in your country right now.
