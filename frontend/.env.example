# Copy to .env (or .env.local) and restart `npm run dev`.

# TADBuddy v2 backend (RAG + memory). Start it from ../tadbuddy-v2 with `docker compose up api`.
VITE_TADBUDDY_API_URL=http://localhost:8000

# Optional fallback if the backend is down: call xAI directly (dev only, exposes the key).
# VITE_XAI_API_KEY=
